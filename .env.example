# Resume Optimizer — Docker Environment
FLASK_DEBUG=0
ARANGO_ENABLED=true
ARANGO_ROOT_PASSWORD=resume_optimizer
CORS_ORIGIN=http://localhost

# DATABASE_URL — controls the database backend.
# If unset, the app uses SQLite (backend/database.db) — suitable for dev/test.
# Set to a postgresql:// URL for production deployments.
#
# SQLite (default — leave unset or set explicitly):
# DATABASE_URL=sqlite:///./database.db
#
# PostgreSQL (production):
# DATABASE_URL=postgresql://resume_user:password@localhost:5432/resume_optimizer
# DATABASE_URL=postgresql://resume_user:password@db:5432/resume_optimizer
#
# Requires: pip install psycopg2-binary  (for PostgreSQL connections)

# Optional: Gateway integration
# HARNESS_URL=http://host.docker.internal:8000/api/harness/run
# VLLM_URL=http://host.docker.internal:8021/v1
