        "query_engine": "Athena with Iceberg support",
        "federation": [
          "Postgres (pharmacy_prod_rds)",
          "Oracle NVTNCRX",
          "Oracle NVTDW"
        ]
      }
    },
    "event_orchestration": {
      "central_hub": "EventHub Lambda",
      "pattern": "Event dependency graph with STATE_TRACKING",
      "relationships": [
        "child of (immediate pass-through)",
        "depends on (wait for all chunks)",
        "complete when (multi-dependency coordination)"
      ],
      "messaging": "SNS FIFO topics → SQS FIFO queues → Lambda consumers",
      "deduplication": "MessageGroupId and MessageDeduplicationId",
      "traceability": "end_to_end_uuid, parent_runtime_uuid, runtime_uuid"
    },
