    "deployment_methodology": "Infrastructure as Code (AWS CDK)",
    "data_volume_capability": "100K+ records per file, multi-client parallel processing"
  },
  "architectural_capabilities": {
    "infrastructure_as_code": {
      "framework": "AWS CDK (Python)",
      "stack_count": 24,
      "deployment_environments": ["prod", "test", "staging", "sandbox"],
      "key_stacks": [
        "lakehouse-main (orchestration hub)",
        "dynamodb-database (state management)",
        "s3-buckets (data lake storage)",
        "export-stack (data distribution)",
        "dq-stack (data quality)",
        "glue-etl-stack (transformation)",
        "datasync (hybrid cloud integration)",
        "collibra-dq (data governance)"
      ],
      "multi_account_support": true,
      "drift_detection": "CloudFormation drift detection enabled"
    },
    "data_pipeline_architecture": {
      "pipeline_stages": [
        {
          "stage": "conversion",
          "purpose": "GPS framework integration, file format normalization",
          "technology": "Lambda (10GB memory, 5GB ephemeral storage)"
        },
        {
          "stage": "landing",
          "purpose": "Initial data ingestion, validation",
          "technology": "Lambda with Pandas layer"
        },
        {
          "stage": "raw",
          "purpose": "Data transformation, canonical mapping, composite key generation",
          "technology": "Lambda (8GB memory), DynamoDB metadata-driven",
          "key_features": [
            "Duplicate column aggregation",
            "Canonical column mapping",
            "Composite key hashing (SHA-256)",
            "Foreign key generation",
            "Mandatory column validation",
            "Client-specific business rules (BSCA ORMB, Fusion invoice normalization)"
          ]
        },
        {
          "stage": "precheck",
          "purpose": "Pre-enrichment data quality checks",
          "technology": "Lambda with Athena/Iceberg integration"
        },
        {
          "stage": "enriched",
          "purpose": "Canonical data model transformation, Iceberg table management",
          "technology": "Lambda (512MB), Athena queries, Iceberg format"
        },
        {
          "stage": "datamart_dim",
          "purpose": "Dimensional model processing",
          "technology": "Lambda (4GB) + Glue ETL jobs"
        },
        {
          "stage": "datamart_fact",
          "purpose": "Fact table processing with business rules",
          "technology": "Lambda (4GB) + Glue ETL jobs"
        },
        {
          "stage": "export",
          "purpose": "Multi-format data export (CSV, Parquet, PDF, 835 EDI)",
          "technology": "Step Functions orchestration, distributed map processing"
        }
      ],
      "orchestration_pattern": "Event-driven with EventHub lambda as central coordinator",
      "idempotency": "Event-based deduplication using PROCESSED_EVENTS_TABLE",
      "state_management": "DynamoDB STATE_TRACKING table with runtime UUIDs"
    },
    "data_quality_framework": {
      "integration": "Collibra DQ",
      "architecture": "VPC-based Lambda integration with external DQ engine",
      "capabilities": [
        "Stage-based DQ assessment (precheck, enriched, datamart)",
        "Job tracking with DynamoDB streams",
        "Automated retry scheduling via EventBridge Scheduler",
        "Error row tracking and aggregation",
        "Results polling with exponential backoff",
        "DQ evaluator for pass/fail determination"
      ],
      "event_driven": "DynamoDB Pipes trigger DQ workflows on state changes"
    },
    "metadata_management": {
      "approach": "Configuration-driven via DynamoDB metadatastores",
      "metadata_tables": [
        "metadatastore_{domain}_ingestion_{client}_{source}_mapping",
        "metadatastore_{domain}_enriched_{client}_{source}_mapping",
        "metadatastore_{domain}_datamart_{client}_table_mapping",
        "metadatastore_{domain}_datamart_{client}_rules_mapping",
        "metadatastore_{domain}_export_{client}_{source}_mapping"
      ],
      "seeding_mechanism": "S3-triggered Lambda with CSV-to-DynamoDB sync",
      "version_control": "Metadata stored in Git, deployed via CDK",
      "dynamic_mapping": "Runtime column mapping and transformation rules"
    },
    "storage_architecture": {
      "data_lake": {
        "primary_bucket": "common-s3-{account}-{region}-{env}",
        "structure": "{domain}/{client}/{source}/{stage}/",
        "encryption": "KMS (S3BucketDefaultKMSKey)",
        "lifecycle": "Intelligent Tiering (immediate transition)",
        "versioning": "Enabled in production"
      },
      "iceberg_tables": {
        "format": "Apache Iceberg",
        "catalog": "AWS Glue Data Catalog",
        "databases": [
          "{domain}_canonical_db",
          "{domain}_datamart_db",
          "{domain}_precheck_db"
        ],
        "optimization": "Weekly vacuum and compaction via scheduled Lambda"
      },
