{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resume-optimizer-schema.production.json",
  "title": "Resume Optimizer Matching Contract",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_profile",
    "job",
    "retrieval_config",
    "matches",
    "gaps",
    "rewrite_targets",
    "generation_constraints"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "candidate_profile": {
      "type": "object",
      "required": ["candidate_id", "target_role_families", "artifacts", "experience_units", "skill_inventory"],
      "properties": {
        "candidate_id": { "type": "string" },
        "target_role_families": {
          "type": "array",
          "items": { "type": "string" }
        },
        "branding_summary": { "type": "string" },
        "artifacts": {
          "type": "object",
          "required": ["linkedin_profile_path", "resume_paths", "experience_journey_path"],
          "properties": {
            "linkedin_profile_path": { "type": "string" },
            "resume_paths": {
              "type": "array",
              "items": { "type": "string" }
            },
            "experience_journey_path": { "type": "string" },
            "job_descriptions_dir": { "type": "string" }
          },
          "additionalProperties": true
        },
        "experience_units": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["experience_id", "title", "company", "date_range", "evidence_refs"],
            "properties": {
              "experience_id": { "type": "string" },
              "title": { "type": "string" },
              "company": { "type": "string" },
              "date_range": {
                "type": "object",
                "required": ["start"],
                "properties": {
                  "start": { "type": "string" },
                  "end": { "type": ["string", "null"] }
                },
                "additionalProperties": false
              },
              "scope_tags": {
                "type": "array",
                "items": { "type": "string" }
              },
              "skills": {
                "type": "array",
                "items": { "type": "string" }
              },
              "leadership_signals": {
                "type": "array",
                "items": { "type": "string" }
              },
              "impact_statements": {
                "type": "array",
                "items": { "type": "string" }
              },
              "evidence_refs": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": true
          }
        },
        "skill_inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["canonical_skill", "aliases"],
            "properties": {
              "canonical_skill": { "type": "string" },
              "aliases": {
                "type": "array",
                "items": { "type": "string" }
              },
              "categories": {
                "type": "array",
                "items": { "type": "string" }
              },
              "proficiency_estimate": { "type": "string" },
              "years_estimate": { "type": ["number", "null"] },
              "evidence_refs": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "job": {
      "type": "object",
      "required": ["job_id", "title", "normalized_requirements"],
      "properties": {
        "job_id": { "type": "string" },
        "company": { "type": "string" },
        "title": { "type": "string" },
        "source_file": { "type": "string" },
        "normalized_requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["requirement_id", "requirement_type", "category", "text", "importance"],
            "properties": {
              "requirement_id": { "type": "string" },
              "requirement_type": {
                "type": "string",
                "enum": ["must_have", "preferred", "leadership", "domain", "education", "certification", "other"]
              },
              "category": { "type": "string" },
              "text": { "type": "string" },
              "canonical_skills": {
                "type": "array",
                "items": { "type": "string" }
              },
              "importance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "retrieval_config": {
      "type": "object",
      "required": ["collection_names", "score_weights"],
      "properties": {
        "collection_names": {
          "type": "object",
          "properties": {
            "candidate_artifacts": { "type": "string" },
            "job_requirements": { "type": "string" },
            "skill_concepts": { "type": "string" },
            "achievement_patterns": { "type": "string" }
          },
          "additionalProperties": true
        },
        "score_weights": {
          "type": "object",
          "required": [
            "semantic_similarity",
            "keyword_alignment",
            "evidence_strength",
            "seniority_alignment",
            "domain_alignment",
            "leadership_alignment",
            "recency_alignment"
          ],
          "properties": {
            "semantic_similarity": { "type": "number" },
            "keyword_alignment": { "type": "number" },
            "evidence_strength": { "type": "number" },
            "seniority_alignment": { "type": "number" },
            "domain_alignment": { "type": "number" },
            "leadership_alignment": { "type": "number" },
            "recency_alignment": { "type": "number" }
          },
          "additionalProperties": false
        },
        "top_k": { "type": "integer" },
        "metadata_filters": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement_id", "overall_score", "match_type", "evidence"],
        "properties": {
          "requirement_id": { "type": "string" },
          "overall_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "match_type": {
            "type": "string",
            "enum": ["direct", "direct_plus_inferred", "partial", "weak", "none"]
          },
          "subscores": {
            "type": "object",
            "properties": {
              "semantic_similarity": { "type": "number" },
              "keyword_alignment": { "type": "number" },
              "evidence_strength": { "type": "number" },
              "seniority_alignment": { "type": "number" },
              "domain_alignment": { "type": "number" },
              "leadership_alignment": { "type": "number" },
              "recency_alignment": { "type": "number" }
            },
            "additionalProperties": false
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["artifact_ref", "evidence_text", "confidence"],
              "properties": {
                "artifact_ref": { "type": "string" },
                "evidence_text": { "type": "string" },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "evidence_type": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "recommended_resume_action": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gap_id", "gap_type", "description", "severity"],
        "properties": {
          "gap_id": { "type": "string" },
          "requirement_id": { "type": "string" },
          "gap_type": {
            "type": "string",
            "enum": [
              "missing_experience",
              "weak_wording",
              "missing_explicit_keyword",
              "insufficient_leadership_signal",
              "seniority_mismatch",
              "domain_gap",
              "unsupported_claim_risk"
            ]
          },
          "description": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "recommended_action": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "rewrite_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["priority", "section", "reason"],
        "properties": {
          "priority": { "type": "integer" },
          "section": { "type": "string" },
          "experience_id": { "type": "string" },
          "reason": { "type": "string" },
          "recommended_keywords": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    },
    "generation_constraints": {
      "type": "object",
      "required": ["truthfulness_policy", "ats_rules", "writing_style"],
      "properties": {
        "truthfulness_policy": {
          "type": "object",
          "properties": {
            "allow_inference": { "type": "boolean" },
            "allow_exaggeration": { "type": "boolean" },
            "require_evidence_for_claims": { "type": "boolean" },
            "label_inferred_claims": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "ats_rules": {
          "type": "object",
          "properties": {
            "avoid_tables": { "type": "boolean" },
            "avoid_graphics": { "type": "boolean" },
            "avoid_columns": { "type": "boolean" },
            "prefer_standard_headings": { "type": "boolean" },
            "use_exact_keywords_where_truthful": { "type": "boolean" },
            "do_not_keyword_stuff": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "writing_style": {
          "type": "object",
          "properties": {
            "tone": { "type": "string" },
            "bullet_style": { "type": "string" },
            "max_bullet_length": { "type": "integer" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
