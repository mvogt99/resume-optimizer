@app.route("/api/campaigns/<int:campaign_id>/generate", methods=["POST"])
def generate_campaign_posts(campaign_id):
    from batch_jobs import get_batch_manager
    from post_generator import PostGenerator

    user_id = request.headers.get("user-id")
    if not user_id:
        return jsonify({"error": "Unauthorized"}), 401

    manager = get_batch_manager()
    job_id = manager.create_job("campaign_posts", user_id, {"campaign_id": campaign_id})

    def worker(jid):
        gen = PostGenerator()
        posts = gen.generate_campaign_posts(campaign_id, user_id, job_id=jid)
        return {"posts_generated": len(posts)}

    manager.start_job(job_id, worker)
    return jsonify({"message": "Post generation started", "job_id": job_id}), 202


@app.route("/api/campaigns/<int:campaign_id>/posts", methods=["GET"])
def list_campaign_posts(campaign_id):
    import sqlite3 as _sqlite3

    from models import DB_PATH as _DB_PATH

    user_id = request.headers.get("user-id")
    if not user_id:
        return jsonify({"error": "Unauthorized"}), 401

    conn = _sqlite3.connect(_DB_PATH)
    conn.row_factory = _sqlite3.Row
    rows = conn.execute(
        "SELECT * FROM campaign_posts WHERE campaign_id = ? ORDER BY position",
        (campaign_id,),
    ).fetchall()
    conn.close()

    posts = []
    for r in rows:
        d = dict(r)
        d["source_refs"] = json.loads(d.get("source_refs", "[]") or "[]")
        d["draft_history"] = json.loads(d.get("draft_history", "[]") or "[]")
        posts.append(d)

    return jsonify({"posts": posts}), 200


@app.route("/api/campaigns/<int:campaign_id>/posts", methods=["POST"])
def add_campaign_post(campaign_id):
    import sqlite3 as _sqlite3

    from models import DB_PATH as _DB_PATH

    user_id = request.headers.get("user-id")
    if not user_id:
        return jsonify({"error": "Unauthorized"}), 401

    data = request.get_json()
    title = data.get("title", "")
    content = data.get("content", "")

    conn = _sqlite3.connect(_DB_PATH)
    # Get max position
    row = conn.execute(
        "SELECT MAX(position) FROM campaign_posts WHERE campaign_id = ?",
        (campaign_id,),
    ).fetchone()
    next_pos = (row[0] or 0) + 1 if row and row[0] is not None else 0

    cursor = conn.cursor()
    cursor.execute(
        "INSERT INTO campaign_posts "
        "(campaign_id, position, title, content, char_count, status) "
        "VALUES (?, ?, ?, ?, ?, 'draft')",
        (campaign_id, next_pos, title, content, len(content)),
    )
    conn.commit()
    post_id = cursor.lastrowid
    conn.close()

    return jsonify({"message": "Post added", "post_id": post_id}), 201


@app.route("/api/campaigns/<int:campaign_id>/posts/<int:post_id>", methods=["PUT"])
def update_campaign_post(campaign_id, post_id):
    import sqlite3 as _sqlite3

    from models import DB_PATH as _DB_PATH

    user_id = request.headers.get("user-id")
    if not user_id:
        return jsonify({"error": "Unauthorized"}), 401

    data = request.get_json()
    updates = []
    values = []
    for field in ("title", "content", "hashtags", "status", "scheduled_date"):
        if field in data:
            updates.append(f"{field} = ?")
            values.append(data[field])
            if field == "content":
                updates.append("char_count = ?")
                values.append(len(data[field]))

    if not updates:
        return jsonify({"error": "No fields to update"}), 400

    updates.append("updated_at = CURRENT_TIMESTAMP")
    values.append(post_id)

    conn = _sqlite3.connect(_DB_PATH)
    conn.execute(
        f"UPDATE campaign_posts SET {', '.join(updates)} WHERE id = ?",
        values,
    )
    conn.commit()
    conn.close()

    return jsonify({"message": "Post updated"}), 200


