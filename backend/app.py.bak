# --- Phase 11: Update interview (re-plan existing campaign) ---


@app.route("/api/campaigns/<int:campaign_id>/update-interview", methods=["POST"])
def update_campaign_interview(campaign_id):
    import json as _json
    import sqlite3 as _sqlite3

    from campaign_interview import get_campaign_interviewer
    from models import DB_PATH as _DB_PATH

    user_id = request.headers.get("user-id")
    if not user_id:
        return jsonify({"error": "Unauthorized"}), 401

    conn = _sqlite3.connect(_DB_PATH)
    conn.row_factory = _sqlite3.Row
    campaign = conn.execute("SELECT * FROM campaigns WHERE id = ?", (campaign_id,)).fetchone()

    if not campaign or str(campaign["user_id"]) != str(user_id):
        conn.close()
        return jsonify({"error": "Campaign not found"}), 404

    # Start a new interview session pre-seeded with campaign theme
    interviewer = get_campaign_interviewer()
    session_data = interviewer.start_session(user_id, initial_theme=campaign["theme"])
    session_id = session_data["session_id"]

    # Pre-populate session context with existing campaign data
    context = {
        "theme": campaign["theme"] or "",
        "audience": campaign["audience"] or "",
        "tone": campaign["tone"] or "",
        "storyline": campaign["storyline"] or "",
        "post_count": campaign["post_count"] or 5,
        "cadence": campaign["cadence"] or "",
    }
    conn.execute(
        """UPDATE campaign_sessions
           SET context_json = ?, campaign_id = ?, stage = 'theme'
           WHERE id = ?""",
        (_json.dumps(context), campaign_id, session_id),
    )
    conn.commit()
    conn.close()

    return (
        jsonify(
            {
                "session_id": session_id,
                "message": session_data.get("message", ""),
                "stage": "theme",
                "context": context,
                "suggestions": session_data.get("suggestions", []),
            }
        ),
        200,
    )


