import json
import os
import uuid

from flask import Flask, jsonify, request, send_file
from flask_cors import CORS
from models import JobDescription, JobSession, Resume, ResumeVersion, User
from nlp_engine import extract_keywords, extract_skill_phrases
from utils import optimize_resume, process_linkedin_profile, process_resume
from werkzeug.utils import secure_filename

# Initialize Flask app
app = Flask(__name__)
app.config["UPLOAD_FOLDER"] = "uploads"
app.config["MAX_CONTENT_LENGTH"] = 16 * 1024 * 1024  # 16MB max file size

# Enable CORS
CORS(app)

# Create upload directory if it doesn't exist
os.makedirs(app.config["UPLOAD_FOLDER"], exist_ok=True)


# Routes
@app.route("/api/register", methods=["POST"])
def register():
    data = request.get_json()
    email = data.get("email")
    password = data.get("password")

    # Check if user already exists
    existing_user = User.find_by_email(email)
    if existing_user:
        return jsonify({"error": "User already exists"}), 409

    # Create new user
    user = User.create(email, password)
    return jsonify({"message": "User created successfully", "user_id": str(user.id)}), 201


@app.route("/api/login", methods=["POST"])
def login():
    data = request.get_json()
    email = data.get("email")
    password = data.get("password")

    user = User.authenticate(email, password)
    if user:
        return jsonify({"message": "Login successful", "user_id": str(user.id)}), 200
    else:
        return jsonify({"error": "Invalid credentials"}), 401


@app.route("/api/resume/upload", methods=["POST"])
def upload_resume():
    user_id = request.headers.get("user-id")
    if not user_id:
        return jsonify({"error": "Unauthorized"}), 401

    if "file" not in request.files:
        return jsonify({"error": "No file provided"}), 400

    file = request.files["file"]
    if file.filename == "":
        return jsonify({"error": "No file selected"}), 400

    if file:
        filename = secure_filename(f"{uuid.uuid4()}_{file.filename}")
        file_path = os.path.join(app.config["UPLOAD_FOLDER"], filename)
        file.save(file_path)

        # Save to database
        resume = Resume.create(user_id, filename, file_path)
        return (
            jsonify({"message": "Resume uploaded successfully", "resume_id": str(resume.id)}),
            201,
        )


@app.route("/api/job-description/upload", methods=["POST"])
def upload_job_description():
    user_id = request.headers.get("user-id")
    if not user_id:
        return jsonify({"error": "Unauthorized"}), 401

    data = request.get_json()
    job_text = data.get("job_text")

    if not job_text:
        return jsonify({"error": "Job description is required"}), 400

    # Save to database
    job_desc = JobDescription.create(user_id, job_text)
    return (
        jsonify({"message": "Job description uploaded successfully", "job_id": str(job_desc.id)}),
        201,
    )


@app.route("/api/optimize-resume/<resume_id>", methods=["POST"])
def optimize_resume_endpoint(resume_id):
    user_id = request.headers.get("user-id")
    if not user_id:
        return jsonify({"error": "Unauthorized"}), 401

    # Get resume and job description
    resume = Resume.get_by_id(resume_id)
    if not resume or str(resume.user_id) != str(user_id):
        return jsonify({"error": "Resume not found or unauthorized"}), 404

    job_desc = JobDescription.get_latest_for_user(user_id)
    if not job_desc:
        return jsonify({"error": "No job description found"}), 404

    # Process resume and job description
    processed_resume = process_resume(resume.file_path)
    job_keywords = extract_skill_phrases(job_desc.text, use_llm_fallback=False)

    # Load deep profile for LLM rewrite enrichment
    deep_profile = None
    try:
        from deep_profile import get_deep_profile_engine

        dp = get_deep_profile_engine().get_profile_with_meta(int(user_id))
        if dp:
            deep_profile = dp.get("profile", dp)
    except Exception:
        pass

    # Pass full job text + LinkedIn profile for multi-signal scoring
    optimized_resume = optimize_resume(
        processed_resume,
        job_keywords,
        job_text=job_desc.text,
        linkedin_profile=_cached_linkedin_raw,
        deep_profile=deep_profile,
    )

    # Determine resume source for display
    resume_source = "upload"
    if "linkedin" in (resume.filename or "").lower():
        resume_source = "linkedin"

    return (
        jsonify(
            {
                "optimized_resume": optimized_resume,
                "keywords_added": len(optimized_resume.get("added_keywords", [])),
                "ats_compliance_score": optimized_resume.get("score", 0),
                "score_breakdown": optimized_resume.get("score_breakdown", {}),
                "accomplishments": optimized_resume.get("accomplishments", []),
                "recommendations": optimized_resume.get("recommendations", []),
                "original_resume_text": optimized_resume.get("original_text", ""),
                "job_description_text": job_desc.text,
                "sections_found": optimized_resume.get("sections_found", {}),
                "skill_phrases_matched": optimized_resume.get("skill_phrases_matched", []),
                "resume_source": resume_source,
                "resume_name": resume.filename,
            }
        ),
        200,
    )


@app.route("/api/resume/download/<resume_id>", methods=["GET"])
def download_resume_endpoint(resume_id):
    """Download optimized resume as PDF or DOCX."""
    user_id = request.headers.get("user-id")
    if not user_id:
        return jsonify({"error": "Missing user-id header"}), 401

    fmt = request.args.get("format", "pdf").lower()
    if fmt not in ("pdf", "docx"):
        return jsonify({"error": "Format must be 'pdf' or 'docx'"}), 400

    # Try resume version first (has parsed_text), then original resume
    version = ResumeVersion.get_by_id(resume_id)
    if version and str(version.user_id) == str(user_id):
        text = version.parsed_text
    else:
        resume = Resume.get_by_id(resume_id)
        if not resume or str(resume.user_id) != str(user_id):
            return jsonify({"error": "Resume not found"}), 404
        # Resume only has file_path — parse the file to get text
        if resume.file_path:
            parsed = process_resume(resume.file_path)
            text = parsed.get("text", "") if isinstance(parsed, dict) else str(parsed)
        else:
            text = ""

    if not text:
        return jsonify({"error": "No resume text available"}), 404

    try:
        if fmt == "pdf":
            from resume_export import export_resume_pdf

            buffer = export_resume_pdf(text)
            mimetype = "application/pdf"
            filename = f"resume_{resume_id}.pdf"
        else:
            from resume_export import export_resume_docx

            buffer = export_resume_docx(text)
            mimetype = "application/vnd.openxmlformats-officedocument" ".wordprocessingml.document"
            filename = f"resume_{resume_id}.docx"

        return send_file(
            buffer,
            mimetype=mimetype,
            as_attachment=True,
            download_name=filename,
        )
    except ImportError as e:
        return jsonify({"error": f"Export dependency missing: {e}"}), 500
    except Exception as e:
        return jsonify({"error": f"Export failed: {e}"}), 500


@app.route("/api/interview-guide/<resume_id>", methods=["GET"])
def get_interview_guide_endpoint(resume_id):
    from interview_guide import generate_interview_guide

    user_id = request.headers.get("user-id")
    if not user_id:
        return jsonify({"error": "Unauthorized"}), 401

    resume = Resume.get_by_id(resume_id)
    if not resume or str(resume.user_id) != str(user_id):
        return jsonify({"error": "Resume not found or unauthorized"}), 404

    job_desc = JobDescription.get_latest_for_user(user_id)
    if not job_desc:
        return jsonify({"error": "No job description found"}), 404

    processed_resume = process_resume(resume.file_path)
    linkedin_raw = _cached_linkedin_raw

    guide = generate_interview_guide(processed_resume, job_desc.text, linkedin_raw)
    return jsonify(guide), 200


# Auto-load LinkedIn profile on startup
# _cached_linkedin_profile: processed format (skills as strings, for resume text)
# _cached_linkedin_raw: raw parsed format (skills as dicts with endorsements)
_cached_linkedin_profile = None
_cached_linkedin_raw = None
try:
    _cached_linkedin_profile = process_linkedin_profile()
    from linkedin_parser import get_default_linkedin_path, parse_linkedin_json

    _cached_linkedin_raw = parse_linkedin_json(get_default_linkedin_path())
except Exception:
    _cached_linkedin_profile = None
    _cached_linkedin_raw = None


@app.route("/api/resume/from-linkedin", methods=["POST"])
def create_resume_from_linkedin():
    """Import LinkedIn profile and create a resume record from it."""
    user_id = request.headers.get("user-id")
    if not user_id:
        return jsonify({"error": "Unauthorized"}), 401

    try:
        profile = _cached_linkedin_profile or process_linkedin_profile()
    except Exception as e:
        return jsonify({"error": str(e)}), 500

    # Save profile text as a .txt file
    filename = f"{uuid.uuid4()}_linkedin_profile.txt"
    file_path = os.path.join(app.config["UPLOAD_FOLDER"], filename)
    with open(file_path, "w", encoding="utf-8") as f:
        f.write(profile["text"])

    resume = Resume.create(user_id, "LinkedIn Profile", file_path)

    return (
        jsonify(
            {
                "message": "Resume created from LinkedIn profile",
                "resume_id": str(resume.id),
                "profile_summary": {
                    "skills_count": len(profile.get("skills", [])),
                    "experience_count": len(profile.get("experience", [])),
                    "education_count": len(profile.get("education", [])),
                },
            }
        ),
        201,
    )


@app.route("/api/import/linkedin", methods=["POST"])
def import_linkedin_profile():
    global _cached_linkedin_profile, _cached_linkedin_raw
    user_id = request.headers.get("user-id")
    if not user_id:
        return jsonify({"error": "Unauthorized"}), 401

    linkedin_path = None
    if request.is_json:
        data = request.get_json()
        linkedin_path = data.get("linkedin_path")

    try:
        from linkedin_parser import get_default_linkedin_path, parse_linkedin_json

        profile = process_linkedin_profile(linkedin_path)
        _cached_linkedin_profile = profile
        raw_path = linkedin_path or get_default_linkedin_path()
        _cached_linkedin_raw = parse_linkedin_json(raw_path)
    except Exception as e:
        return jsonify({"error": str(e)}), 500

    return (
        jsonify(
            {
                "message": "LinkedIn profile imported successfully",
                "skills_count": len(profile.get("skills", [])),
                "experience_count": len(profile.get("experience", [])),
                "education_count": len(profile.get("education", [])),
                "recommendations_count": len(profile.get("recommendations", [])),
            }
        ),
        200,
    )


@app.route("/api/profile/linkedin", methods=["GET"])
def get_linkedin_profile():
    user_id = request.headers.get("user-id")
    if not user_id:
        return jsonify({"error": "Unauthorized"}), 401

    if _cached_linkedin_profile is not None:
        return jsonify(_cached_linkedin_profile), 200

    try:
        profile = process_linkedin_profile()
        return jsonify(profile), 200
    except Exception as e:
        return jsonify({"error": str(e)}), 500


# --- Phase 3: Skills gap analysis ---


def _gather_project_journey_evidence(user_id):
    """Gather skill evidence from client projects and AI journey events."""
    import sqlite3 as _sqlite3

    from models import DB_PATH as _DB_PATH

    evidence = []

    # From client projects (completed analysis)
    try:
        from project_analyzer import get_project_analyzer

        analyzer = get_project_analyzer()
        clients = analyzer.get_clients_for_user(user_id)
        for client in clients:
            if client.get("analysis_status") != "completed":
                continue
            skills_data = client.get("skills_json") or {}
            if isinstance(skills_data, str):
                skills_data = json.loads(skills_data) if skills_data else {}
            tech_skills = []
            for cat_skills in skills_data.values():
                if isinstance(cat_skills, list):
                    tech_skills.extend(
                        [s if isinstance(s, str) else s.get("name", "") for s in cat_skills]
                    )
            if tech_skills:
                evidence.append(
                    {
                        "source": f"Client Project: {client['client_name']}",
                        "detail": "Used in project documentation",
                        "skills": tech_skills,
                    }
                )
    except Exception:
        pass

    # From AI journey events
    try:
        conn = _sqlite3.connect(_DB_PATH)
        conn.row_factory = _sqlite3.Row
        events = conn.execute(
            "SELECT technologies, source_type, title FROM journey_events WHERE technologies != '[]'"
        ).fetchall()
        conn.close()
        for evt in events:
            techs = json.loads(evt["technologies"] or "[]")
            if techs:
                evidence.append(
                    {
                        "source": f"AI Journey: {evt['title'] or evt['source_type']}",
                        "detail": "Demonstrated in development history",
                        "skills": techs,
                    }
                )
    except Exception:
        pass

    return evidence


@app.route("/api/skills-gap/<resume_id>", methods=["GET"])
def get_skills_gap(resume_id):
    from skills_optimizer import (
        analyze_skills_gap,
        get_relevant_accomplishments,
        match_recommendations,
    )

    user_id = request.headers.get("user-id")
    if not user_id:
        return jsonify({"error": "Unauthorized"}), 401

    resume = Resume.get_by_id(resume_id)
    if not resume or str(resume.user_id) != str(user_id):
        return jsonify({"error": "Resume not found or unauthorized"}), 404

    job_desc = JobDescription.get_latest_for_user(user_id)
    if not job_desc:
        return jsonify({"error": "No job description found"}), 404

    processed_resume = process_resume(resume.file_path)
    linkedin_raw = _cached_linkedin_raw

    project_journey_evidence = _gather_project_journey_evidence(user_id)
    gap_analysis = analyze_skills_gap(
        processed_resume, job_desc.text, linkedin_raw, project_journey_evidence
    )

    result = {"skills_gap": gap_analysis}

    if linkedin_raw:
        result["relevant_accomplishments"] = get_relevant_accomplishments(
            linkedin_raw, job_desc.text
        )
        result["relevant_recommendations"] = match_recommendations(linkedin_raw, job_desc.text)

    return jsonify(result), 200


@app.route("/api/skills-gap/<resume_id>/rescore", methods=["POST"])
def rescore_skills_gap(resume_id):
    """Re-score skills gap with user-adjusted skill lists."""
    from skills_optimizer import (
        analyze_skills_gap,
        get_relevant_accomplishments,
        match_recommendations,
    )

    user_id = request.headers.get("user-id")
    if not user_id:
        return jsonify({"error": "Unauthorized"}), 401

    resume = Resume.get_by_id(resume_id)
    if not resume or str(resume.user_id) != str(user_id):
        return jsonify({"error": "Resume not found or unauthorized"}), 404

    job_desc = JobDescription.get_latest_for_user(user_id)
    if not job_desc:
        return jsonify({"error": "No job description found"}), 404

    data = request.get_json() or {}
    # User can provide confirmed skills to add to their resume skills list
    confirmed_skills = data.get("confirmed_skills", [])
    # User can provide skills to remove from the job requirements
    removed_skills = data.get("removed_skills", [])
    # User can add custom skills they have
    added_skills = data.get("added_skills", [])

    processed_resume = process_resume(resume.file_path)
    linkedin_raw = _cached_linkedin_raw

    # Augment resume skills with user-confirmed and user-added skills
    if confirmed_skills or added_skills:
        extra_skills = confirmed_skills + added_skills
        existing_skills = processed_resume.get("skills", [])
        processed_resume["skills"] = list(set(existing_skills + [s.lower() for s in extra_skills]))
        # Also inject into resume text so substring matching works
        processed_resume["text"] = (
            processed_resume.get("text", "") + "\n\nAdditional Skills: " + ", ".join(extra_skills)
        )

    project_journey_evidence = _gather_project_journey_evidence(user_id)
    gap_analysis = analyze_skills_gap(
        processed_resume, job_desc.text, linkedin_raw, project_journey_evidence
    )

    # Filter out user-removed skills from results
    if removed_skills:
        removed_lower = {s.lower() for s in removed_skills}
        for key in ("skills_already_shown", "skills_to_emphasize", "skills_to_acquire"):
            gap_analysis[key] = [
                s for s in gap_analysis[key] if s["skill"].lower() not in removed_lower
            ]
        # Recalculate coverage
        total = gap_analysis["total_job_keywords"] - len(removed_lower)
        shown = len(gap_analysis["skills_already_shown"])
        can_add = len(gap_analysis["skills_to_emphasize"])
        coverage = ((shown + can_add) / total * 100) if total > 0 else 0
        gap_analysis["coverage_percent"] = round(coverage, 1)
        gap_analysis["total_job_keywords"] = total
        gap_analysis["gap_summary"] = {
            "shown": shown,
            "can_add": can_add,
            "need_to_learn": len(gap_analysis["skills_to_acquire"]),
        }

    result = {"skills_gap": gap_analysis}

    if linkedin_raw:
        result["relevant_accomplishments"] = get_relevant_accomplishments(
            linkedin_raw, job_desc.text
        )
        result["relevant_recommendations"] = match_recommendations(linkedin_raw, job_desc.text)

    return jsonify(result), 200


# --- Phase 4: Google Drive ---


@app.route("/api/resumes/gdrive", methods=["GET"])
def list_gdrive_files():
    from gdrive_service import get_gdrive_service

    user_id = request.headers.get("user-id")
    if not user_id:
        return jsonify({"error": "Unauthorized"}), 401

    folder_name = request.args.get("folder")
    folder_id = request.args.get("folder_id")

    try:
        gdrive = get_gdrive_service()
        if folder_id:
            result = gdrive.list_folder_by_id(folder_id)
        elif folder_name:
            result = gdrive.list_resume_folder(folder_name)
        else:
            result = gdrive.get_root_folders()
        return jsonify(result), 200
    except Exception as e:
        return jsonify({"error": str(e)}), 500


@app.route("/api/resumes/gdrive/import", methods=["POST"])
def import_gdrive_file():
    from gdrive_service import get_gdrive_service

    user_id = request.headers.get("user-id")
    if not user_id:
        return jsonify({"error": "Unauthorized"}), 401

    data = request.get_json()
    file_id = data.get("file_id")
    if not file_id:
        return jsonify({"error": "file_id is required"}), 400

    try:
        gdrive = get_gdrive_service()
        imported = gdrive.import_file(file_id)

        # Save as a resume version
        version = ResumeVersion.create(
            user_id=user_id,
            source="google_drive",
            file_name=imported["file_name"],
            parsed_text=imported["text"],
            source_id=imported["file_id"],
            file_type=imported["file_type"],
            metadata_json=json.dumps(
                {
                    "mime_type": imported["mime_type"],
                    "modified_time": imported["modified_time"],
                }
            ),
        )

        # Also save as a regular resume file for optimization
        filename = f"{uuid.uuid4()}_{imported['file_name']}.txt"
        file_path = os.path.join(app.config["UPLOAD_FOLDER"], filename)
        with open(file_path, "w", encoding="utf-8") as f:
            f.write(imported["text"])

        resume = Resume.create(user_id, imported["file_name"], file_path)

        return (
            jsonify(
                {
                    "message": "File imported from Google Drive",
                    "resume_id": str(resume.id),
                    "version_id": str(version.id),
                    "file_name": imported["file_name"],
                    "file_type": imported["file_type"],
                    "text_length": len(imported["text"]),
                }
            ),
            201,
        )

    except Exception as e:
        return jsonify({"error": str(e)}), 500


@app.route("/api/resumes/versions", methods=["GET"])
def list_resume_versions():
    user_id = request.headers.get("user-id")
    if not user_id:
        return jsonify({"error": "Unauthorized"}), 401

    versions = ResumeVersion.get_all_for_user(user_id)
