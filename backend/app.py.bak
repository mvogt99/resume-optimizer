@app.route("/api/campaigns/<int:campaign_id>/posts/reorder", methods=["PUT"])
def reorder_campaign_posts(campaign_id):
    import sqlite3 as _sqlite3

    from models import DB_PATH as _DB_PATH

    user_id = request.headers.get("user-id")
    if not user_id:
        return jsonify({"error": "Unauthorized"}), 401

    data = request.get_json()
    order = data.get("order", [])

    if not order:
        return jsonify({"error": "order array required"}), 400

    conn = _sqlite3.connect(_DB_PATH)
    for pos, pid in enumerate(order):
        conn.execute(
            "UPDATE campaign_posts SET position = ? WHERE id = ? AND campaign_id = ?",
            (pos, pid, campaign_id),
        )
    conn.commit()
    conn.close()

    return jsonify({"message": "Posts reordered"}), 200


# --- Phase 11: Export ---


@app.route("/api/campaigns/<int:campaign_id>/export", methods=["GET"])
def export_campaign(campaign_id):
    import sqlite3 as _sqlite3

    from models import DB_PATH as _DB_PATH

    user_id = request.headers.get("user-id")
    if not user_id:
        return jsonify({"error": "Unauthorized"}), 401

    conn = _sqlite3.connect(_DB_PATH)
    conn.row_factory = _sqlite3.Row
    campaign = conn.execute("SELECT * FROM campaigns WHERE id = ?", (campaign_id,)).fetchone()

    if not campaign or str(campaign["user_id"]) != str(user_id):
        conn.close()
        return jsonify({"error": "Campaign not found"}), 404

    posts = conn.execute(
        "SELECT * FROM campaign_posts WHERE campaign_id = ? ORDER BY position",
        (campaign_id,),
    ).fetchall()
    conn.close()

    lines = [
        f"Campaign: {campaign['theme']}",
        f"Audience: {campaign['audience']}",
        f"Tone: {campaign['tone']}",
        f"Posts: {len(posts)}",
        "",
        "=" * 60,
    ]

    for p in posts:
        lines.append("")
        lines.append(f"--- Post {p['position'] + 1}: {p['title']} ---")
        lines.append("")
        lines.append(p["content"] or "[No content yet]")
        if p["hashtags"]:
            lines.append("")
            lines.append(p["hashtags"])
        lines.append("")
        lines.append("-" * 40)

    text = "\n".join(lines)
    return jsonify({"text": text, "post_count": len(posts)}), 200


