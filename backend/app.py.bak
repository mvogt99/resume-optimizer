from builder_interview import get_builder_interviewer  # noqa: E402
from resume_builder import get_resume_builder  # noqa: E402
from skills_optimizer import analyze_skills_gap  # noqa: E402


@app.route("/api/builder/sources", methods=["GET"])
def builder_get_sources():
    """List available data sources with counts."""
    user_id = request.headers.get("user-id")
    if not user_id:
        return jsonify({"error": "Unauthorized"}), 401

    builder = get_resume_builder()
    sources = builder.get_available_sources(user_id)

    # Enrich linkedin info from cached profile
    if _cached_linkedin_raw:
        skills = _cached_linkedin_raw.get("skills", [])
        sources["linkedin"]["available"] = True
        sources["linkedin"]["skills_count"] = len(skills)
        exp = _cached_linkedin_raw.get("experience", [])
        sources["linkedin"]["experience_count"] = len(exp)
        recs = _cached_linkedin_raw.get("recommendations", [])
        sources["linkedin"]["recommendations_count"] = len(recs)

    return jsonify(sources), 200


@app.route("/api/builder/start", methods=["POST"])
def builder_start():
    """Start a builder session — select base resume + job description + sources."""
    user_id = request.headers.get("user-id")
    if not user_id:
        return jsonify({"error": "Unauthorized"}), 401

    data = request.get_json() or {}
    base_version_id = data.get("base_version_id")
    job_text = data.get("job_text", "")
    selected_sources = data.get("sources", [])  # ["linkedin", "projects", "journey", "experiences"]

    if not job_text or len(job_text) < 50:
        return jsonify({"error": "Job description must be at least 50 characters"}), 400

    builder = get_resume_builder()
    session_id = builder.create_session(user_id, base_version_id, job_text)

    # Store selected sources
    builder.update_session(session_id, sources_json=json.dumps(selected_sources))

    return (
        jsonify(
            {
                "session_id": session_id,
                "status": "draft",
                "message": "Builder session created",
            }
        ),
        201,
    )


@app.route("/api/builder/preview/<session_id>", methods=["GET"])
def builder_preview(session_id):
    """Preview the enriched resume with source attribution."""
    user_id = request.headers.get("user-id")
    if not user_id:
        return jsonify({"error": "Unauthorized"}), 401

    builder = get_resume_builder()
    session = builder.get_session(session_id)
    if not session or str(session["user_id"]) != str(user_id):
        return jsonify({"error": "Session not found"}), 404

    # Load all selected sources
    selected = json.loads(session["sources_json"]) if session["sources_json"] != "{}" else []
    if isinstance(selected, dict):
        selected = list(selected.keys())

    base = builder.load_base_resume(session.get("base_version_id"))
    sources_data = {}

    if "linkedin" in selected:
        sources_data["linkedin"] = builder.load_linkedin_profile(_cached_linkedin_raw)
    if "projects" in selected:
        sources_data["projects"] = builder.load_project_insights()
    if "journey" in selected:
        sources_data["journey"] = builder.load_journey_data()
    if "experiences" in selected:
        sources_data["experiences"] = builder.load_experiences()

    result = builder.build_enriched_resume(
        job_text=session["job_text"],
        base_text=base.get("text", ""),
        sources=sources_data,
    )

    # Compute ATS score using the enriched text
    from utils import optimize_resume as _opt

    enriched_data = {
        "text": result["text"],
        "skills": extract_skill_phrases(result["text"], use_llm_fallback=False),
    }
    job_kw = extract_skill_phrases(session["job_text"], use_llm_fallback=False)
    score_result = _opt(
        enriched_data, job_kw, job_text=session["job_text"], linkedin_profile=_cached_linkedin_raw
    )

    return (
        jsonify(
            {
                "session_id": session_id,
                "text": result["text"],
                "sections": {
                    k: len(v) if isinstance(v, list) else 0 for k, v in result["sections"].items()
                },
                "sections_detail": result["sections"],
                "sources_used": result["sources_used"],
                "relevance_scores": result["relevance_scores"],
                "ats_score": score_result.get("score", 0),
                "score_breakdown": score_result.get("score_breakdown", {}),
            }
        ),
        200,
    )


@app.route("/api/builder/interview/start", methods=["POST"])
def builder_interview_start():
    """Start a gap-driven interview round."""
    user_id = request.headers.get("user-id")
    if not user_id:
        return jsonify({"error": "Unauthorized"}), 401

    data = request.get_json() or {}
    builder_session_id = data.get("session_id")
    if not builder_session_id:
        return jsonify({"error": "session_id required"}), 400

    builder = get_resume_builder()
    session = builder.get_session(builder_session_id)
    if not session or str(session["user_id"]) != str(user_id):
        return jsonify({"error": "Builder session not found"}), 404

    job_text = session["job_text"]

    # Analyze gaps: what does the job need that the current resume doesn't have?
    # Build current resume data from preview
    selected = json.loads(session["sources_json"]) if session["sources_json"] != "{}" else []
    if isinstance(selected, dict):
        selected = list(selected.keys())

    base = builder.load_base_resume(session.get("base_version_id"))
    resume_data = {
        "text": base.get("text", ""),
        "skills": extract_keywords(base.get("text", ""), 30),
    }

    gap_analysis = analyze_skills_gap(resume_data, job_text, _cached_linkedin_raw)

    # Build gaps list for the interviewer
    gaps = []
    for item in gap_analysis.get("skills_to_acquire", []):
        gaps.append({"skill": item["skill"], "category": "technical"})
    for item in gap_analysis.get("skills_to_emphasize", []):
        gaps.append({"skill": item["skill"], "category": "emphasize"})

    interviewer = get_builder_interviewer()
    result = interviewer.start_session(user_id, builder_session_id, job_text, gaps)

    # Update builder session status
    builder.update_session(builder_session_id, status="interviewing")

    return jsonify(result), 201


