# CloudLift environment — "local" for dev, "aws" for test/prod
CLOUDLIFT_ENV=local

# ArangoDB
ARANGO_HOST=http://localhost:8529
ARANGO_DB=hybrid_ai
ARANGO_USER=root
ARANGO_PASSWORD=openSesame

# Artemis (STOMP message broker)
ARTEMIS_HOST=localhost
ARTEMIS_PORT=61613
ARTEMIS_USER=artemis
ARTEMIS_PASS=artemis

# Harness gateway (RTX 5090 local AI)
HARNESS_URL=http://localhost:8000/api/harness/run
HARNESS_STATS_URL=http://localhost:8000/api/harness/stats

# PersonaForge
PF_URL=http://localhost:8090

# Qdrant vector store
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Qdrant Cloud (CLOUDLIFT_ENV=aws) — mv-test-cluster, us-east-2
QDRANT_CLOUD_URL=https://fb46d143-3577-43a4-a9d5-c09ea6f2f59a.us-east-2-0.aws.cloud.qdrant.io
QDRANT_API_KEY=<your-qdrant-cloud-api-key>

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Flask
FLASK_DEBUG=0
SECRET_KEY=change-me-in-production

# Phase 3.1 — RDS PostgreSQL (CLOUDLIFT_ENV=aws)
RDS_SECRET_ARN=ro/test/db
RDS_HOST=
RDS_PORT=5432
RDS_DB=ro_test
