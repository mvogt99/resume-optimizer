#!/usr/bin/env bash
#
# ro — Resume Optimizer service manager
# Manages Flask backend (port 5000) and React frontend (port 3000)
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
STATE_DIR="$SCRIPT_DIR/.ro"
BACKEND_DIR="$SCRIPT_DIR/backend"
FRONTEND_DIR="$SCRIPT_DIR/frontend"
VENV_DIR="$SCRIPT_DIR/.venv"

BACKEND_PORT=5000
FRONTEND_PORT=3000

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'

# Ensure state directory exists
mkdir -p "$STATE_DIR"

usage() {
    cat <<EOF
${BOLD}ro${NC} — Resume Optimizer service manager

${BOLD}Usage:${NC}
  ./ro status                  Show service status
  ./ro start [backend|frontend] Start services
  ./ro stop [backend|frontend]  Stop services
  ./ro restart [backend|frontend] Restart services
  ./ro logs backend|frontend   Tail service logs

${BOLD}Examples:${NC}
  ./ro start           Start both backend and frontend
  ./ro start backend   Start backend only
  ./ro stop            Stop both services
  ./ro logs backend    Tail backend logs (Ctrl+C to exit)
EOF
}

# Check if a port is listening
port_listening() {
    ss -tlnp 2>/dev/null | grep -q ":$1 " && return 0 || return 1
}

# Get PID of process listening on a port
port_pid() {
    ss -tlnp 2>/dev/null | grep ":$1 " | grep -oP 'pid=\K[0-9]+' | head -1
}

# Check if a PID is alive
pid_alive() {
    [ -n "$1" ] && kill -0 "$1" 2>/dev/null
}

# Read PID from file, return empty if stale
read_pid() {
    local pidfile="$STATE_DIR/$1.pid"
    if [ -f "$pidfile" ]; then
        local pid
        pid=$(cat "$pidfile")
        if pid_alive "$pid"; then
            echo "$pid"
        else
            # Stale PID file — clean up
            rm -f "$pidfile"
            echo ""
        fi
    else
        echo ""
    fi
}

# ── STATUS ──────────────────────────────────────────────

status_service() {
    local name=$1
    local port=$2
    local pid
    pid=$(read_pid "$name")
    local port_up
    port_up=$(port_listening "$port" && echo "yes" || echo "no")

    if [ -n "$pid" ] && [ "$port_up" = "yes" ]; then
        printf "  ${GREEN}%-10s${NC} running   PID %-8s port %s\n" "$name" "$pid" "$port"
    elif [ "$port_up" = "yes" ]; then
        local ext_pid
        ext_pid=$(port_pid "$port")
        printf "  ${YELLOW}%-10s${NC} running   PID %-8s port %s (external)\n" "$name" "${ext_pid:-?}" "$port"
    elif [ -n "$pid" ]; then
        printf "  ${YELLOW}%-10s${NC} started   PID %-8s port %s not responding\n" "$name" "$pid" "$port"
    else
        printf "  ${RED}%-10s${NC} stopped   %s             port %s\n" "$name" "" "$port"
    fi
}

cmd_status() {
    echo -e "${BOLD}Resume Optimizer${NC}"
    echo ""
    status_service "backend" "$BACKEND_PORT"
    status_service "frontend" "$FRONTEND_PORT"
    echo ""
}

# ── START ───────────────────────────────────────────────

start_backend() {
    local pid
    pid=$(read_pid "backend")
    if [ -n "$pid" ]; then
        echo -e "  ${YELLOW}backend already running${NC} (PID $pid)"
        return 0
    fi

    if port_listening "$BACKEND_PORT"; then
        local ext_pid
        ext_pid=$(port_pid "$BACKEND_PORT")
        echo -e "  ${YELLOW}port $BACKEND_PORT already in use${NC} (PID ${ext_pid:-?})"
        echo "  Stop the existing process first, or use a different port."
        return 1
    fi

    if [ ! -d "$VENV_DIR" ]; then
        echo -e "  ${RED}Python venv not found${NC} at $VENV_DIR"
        echo "  Run: python -m venv .venv && source .venv/bin/activate && pip install -r backend/requirements.txt"
        return 1
    fi

    echo -n "  Starting backend..."

    (
        cd "$BACKEND_DIR"
        source "$VENV_DIR/bin/activate"
        # CORS_ALLOW_ALL lets browsers on other LAN machines reach the API
        CORS_ALLOW_ALL=1 SUPPORT_GATEWAY_TOKEN="$(curl -s -X POST http://localhost:8000/api/support/auth/login -H 'Content-Type: application/json' -d '{"email":"mvogt99@gmail.com","password":"support_local_2026"}' | python3 -c 'import sys,json; print(json.load(sys.stdin).get("access_token",""))')" python app.py >> "$STATE_DIR/backend.log" 2>&1 &
        echo $! > "$STATE_DIR/backend.pid"
    )

    # Wait for port to come up (max 10s)
    local waited=0
    while [ $waited -lt 10 ]; do
        if port_listening "$BACKEND_PORT"; then
            echo -e " ${GREEN}OK${NC} (port $BACKEND_PORT)"
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
        echo -n "."
    done

    # Check if process is still alive even if port isn't up yet
    pid=$(read_pid "backend")
    if [ -n "$pid" ]; then
        echo -e " ${YELLOW}started${NC} (PID $pid, port $BACKEND_PORT not yet responding)"
        echo "  Check logs: ./ro logs backend"
    else
        echo -e " ${RED}FAILED${NC}"
        echo "  Check logs: tail -20 $STATE_DIR/backend.log"
        return 1
    fi
}

start_frontend() {
    local pid
    pid=$(read_pid "frontend")
    if [ -n "$pid" ]; then
        echo -e "  ${YELLOW}frontend already running${NC} (PID $pid)"
        return 0
    fi

    if port_listening "$FRONTEND_PORT"; then
        local ext_pid
        ext_pid=$(port_pid "$FRONTEND_PORT")
        echo -e "  ${YELLOW}port $FRONTEND_PORT already in use${NC} (PID ${ext_pid:-?})"
        echo "  Stop the existing process first, or use a different port."
        return 1
    fi

    if [ ! -d "$FRONTEND_DIR/node_modules" ]; then
        echo -e "  ${RED}node_modules not found${NC}"
        echo "  Run: cd frontend && npm install"
        return 1
    fi

    echo -n "  Starting frontend..."

    (
        cd "$FRONTEND_DIR"
        BROWSER=none npx vite --port $FRONTEND_PORT --host >> "$STATE_DIR/frontend.log" 2>&1 &
        echo $! > "$STATE_DIR/frontend.pid"
    )

    # Give it a moment to confirm the process started
    sleep 2
    pid=$(read_pid "frontend")
    if [ -n "$pid" ]; then
        echo -e " ${GREEN}OK${NC} (PID $pid, port $FRONTEND_PORT)"
    else
        echo -e " ${RED}FAILED${NC}"
        echo "  Check logs: tail -20 $STATE_DIR/frontend.log"
        return 1
    fi
}

cmd_start() {
    local target="${1:-all}"
    echo -e "${BOLD}Starting services${NC}"
    echo ""

    case "$target" in
        backend)
            start_backend
            ;;
        frontend)
            start_frontend
            ;;
        all)
            start_backend
            echo ""
            start_frontend
            ;;
        *)
            echo -e "  ${RED}Unknown service:${NC} $target"
            echo "  Use: backend, frontend, or omit for both"
            return 1
            ;;
    esac
    echo ""
}

# ── STOP ────────────────────────────────────────────────

stop_service() {
    local name=$1
    local port=$2
    local pid
    pid=$(read_pid "$name")

    if [ -z "$pid" ] && ! port_listening "$port"; then
        echo -e "  ${BLUE}$name${NC} not running"
        return 0
    fi

    echo -n "  Stopping $name..."

    # Kill tracked PID
    if [ -n "$pid" ]; then
        kill "$pid" 2>/dev/null || true

        # Wait up to 5s for graceful shutdown
        local waited=0
        while [ $waited -lt 5 ] && pid_alive "$pid"; do
            sleep 1
            waited=$((waited + 1))
        done

        # Force kill if still alive
        if pid_alive "$pid"; then
            kill -9 "$pid" 2>/dev/null || true
            sleep 1
        fi

        rm -f "$STATE_DIR/$name.pid"
    fi

    # Fallback: kill anything still on the port
    if port_listening "$port"; then
        local port_proc
        port_proc=$(port_pid "$port")
        if [ -n "$port_proc" ]; then
            kill "$port_proc" 2>/dev/null || true
            sleep 2
            if pid_alive "$port_proc"; then
                kill -9 "$port_proc" 2>/dev/null || true
            fi
        fi
    fi

    if ! port_listening "$port"; then
        echo -e " ${GREEN}stopped${NC}"
    else
        echo -e " ${YELLOW}port $port still in use${NC} — may need manual cleanup"
    fi
}

cmd_stop() {
    local target="${1:-all}"
    echo -e "${BOLD}Stopping services${NC}"
    echo ""

    case "$target" in
        backend)
            stop_service "backend" "$BACKEND_PORT"
            ;;
        frontend)
            stop_service "frontend" "$FRONTEND_PORT"
            ;;
        all)
            stop_service "frontend" "$FRONTEND_PORT"
            stop_service "backend" "$BACKEND_PORT"
            ;;
        *)
            echo -e "  ${RED}Unknown service:${NC} $target"
            return 1
            ;;
    esac
    echo ""
}

# ── RESTART ─────────────────────────────────────────────

cmd_restart() {
    local target="${1:-all}"
    cmd_stop "$target"
    cmd_start "$target"
}

# ── LOGS ────────────────────────────────────────────────

cmd_logs() {
    local name="${1:-}"
    if [ -z "$name" ]; then
        echo "Usage: ./ro logs backend|frontend"
        return 1
    fi

    local logfile="$STATE_DIR/$name.log"
    case "$name" in
        backend|frontend)
            if [ ! -f "$logfile" ]; then
                echo "No log file yet. Start the service first: ./ro start $name"
                return 1
            fi
            echo -e "${BOLD}Tailing $name logs${NC} (Ctrl+C to exit)"
            echo ""
            tail -f "$logfile"
            ;;
        *)
            echo -e "  ${RED}Unknown service:${NC} $name"
            echo "  Use: backend or frontend"
            return 1
            ;;
    esac
}

# ── MAIN ────────────────────────────────────────────────

cmd="${1:-}"
shift || true

case "$cmd" in
    status)   cmd_status "$@" ;;
    start)    cmd_start "$@" ;;
    stop)     cmd_stop "$@" ;;
    restart)  cmd_restart "$@" ;;
    logs)     cmd_logs "$@" ;;
    "")       usage ;;
    *)
        echo -e "${RED}Unknown command:${NC} $cmd"
        echo ""
        usage
        exit 1
        ;;
esac
